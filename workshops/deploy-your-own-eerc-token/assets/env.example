# Copy to .env in the repository root. Never commit the filled-in file.
# Use a dedicated test account. Never a wallet that holds real funds.

# Deployer private key, without the 0x prefix is also accepted by ethers.
PRIVATE_KEY=your_test_private_key_here

# Fuji C-Chain. The hardhat config falls back to mainnet if this is unset,
# so set it explicitly even though the fuji network entry hardcodes its own URL.
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Token metadata, read by scripts/deploy-standalone.ts.
# Defaults if unset: name "Test", symbol "TEST", decimals 2.
EERC_NAME=CollegeToken
EERC_SYMBOL=CLGT
EERC_DECIMALS=2

# Optional: set to any value to enable the gas reporter on test runs.
# REPORT_GAS=1
